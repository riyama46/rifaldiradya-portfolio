# Copy to .env.local for local development. Never commit real values.
# Production values are set in Hostinger → Node.js app → Environment variables (SDD section 9).

# Site
SITE_URL=http://localhost:3000

# Database (local: matches docker-compose.yml; production: hPanel → Databases). Use 127.0.0.1, not localhost.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=portfolio
DATABASE_USER=portfolio
DATABASE_PASSWORD=

# Admin login. Run `npm run hash-password` in your own terminal: it prints ADMIN_PASSWORD_HASH
# (base64, no `$`) and a random RATE_LIMIT_SALT. Admin login stays disabled until these are valid.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
RATE_LIMIT_SALT=

# Cloudinary (T-16)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Analytics 4 (T-19). Leave empty to disable analytics and the consent banner.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Only for running `npm start` locally without real secrets. Never set in production.
# SKIP_ENV_VALIDATION=1
