// Copies /drizzle (journal + SQL) into lib/db/migrations.generated.ts so production servers can
// migrate without the /drizzle folder on disk (Hostinger only ships the build output).
// Runs automatically after `npm run db:generate`; run `npm run db:embed` after editing a custom
// migration by hand. tests/unit/migrations.test.ts fails if the two ever drift apart.
import { readFileSync, writeFileSync } from "node:fs";

type Journal = { entries: { tag: string; when: number; breakpoints: boolean }[] };

const journal = JSON.parse(readFileSync("drizzle/meta/_journal.json", "utf8")) as Journal;

const migrations = journal.entries.map((entry) => ({
  tag: entry.tag,
  when: entry.when,
  breakpoints: entry.breakpoints,
  sql: readFileSync(`drizzle/${entry.tag}.sql`, "utf8"),
}));

const output = `// Generated by scripts/embed-migrations.mts from /drizzle. Do not edit by hand.
export const embeddedMigrations: readonly {
  tag: string;
  when: number;
  breakpoints: boolean;
  sql: string;
}[] = ${JSON.stringify(migrations, null, 2)};
`;

writeFileSync("lib/db/migrations.generated.ts", output);
console.log(`[embed-migrations] embedded ${migrations.length} migration(s)`);
